# Core
JOBFORGE_DB_URL=sqlite:///./jobforge.db
JOBFORGE_SECRET_KEY=change-me
JOBFORGE_SCRAPE_INTERVAL_MINUTES=120
JOBFORGE_AUTO_REFRESH=true

# LLM: openai | ollama | none
JOBFORGE_LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional JobSpy source. Install requirements-full.txt first.
JOBFORGE_ENABLE_JOBSPY=false

OLLAMA_FAST_MODEL=qwen3.5:4b
JOBFORGE_AI_TIMEOUT_SECONDS=120
